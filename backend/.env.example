# HireLoop AI Job Assistant - Environment Configuration
# Copy this file to .env and add your API keys

# ===========================================
# AI CONFIGURATION (REQUIRED for AI features)
# ===========================================
# Set ONE of these keys to enable AI-powered features:
# - Profile analysis with career insights
# - ATS-optimized CV generation
# - LinkedIn optimization
# - Intelligent job matching

# OpenAI API Key (RECOMMENDED - Get from: https://platform.openai.com/api-keys)
# Uses GPT-4o for complex analysis, GPT-4o-mini for fast operations
OPENAI_API_KEY=your_openai_api_key_here

# Alternative: Anthropic API Key (Get from: https://console.anthropic.com/)
# Uses Claude 3.5 Sonnet for complex tasks, Claude 3 Haiku for fast operations
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ===========================================
# JOB API CONFIGURATION (Optional)
# ===========================================
# Configure these to fetch REAL job listings
# Without these, the app provides smart job board links instead

# Adzuna API (https://developer.adzuna.com/)
# Free tier: 1000 requests/month
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key

# Jooble API (https://jooble.org/api/about)
# Free tier: 500 requests/day
JOOBLE_API_KEY=your_jooble_api_key

# ===========================================
# SERVER CONFIGURATION
# ===========================================
PORT=5000
NODE_ENV=development
